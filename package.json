{
  "name": "latteschain",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "validator:start": "solana-test-validator --reset --url https://api.devnet.solana.com --clone Memo1UhkJRfHyvLMcVucJwxXeuD728EqVDDwQDxFMNo --clone 22zoJMtdu4tQc2PzL74ZUT7FrwgB1Udec8DdW4yw4BdG",
    "validator:check": "node scripts/validator-template-generator.mjs check",
    "validator:template": "node scripts/validator-template-generator.mjs generate",
    "validator:cmd": "node scripts/validator-template-generator.mjs start",
    "anchor:build": "cd educore_contracts && anchor build",
    "anchor:test": "cd educore_contracts && anchor test --skip-local-validator",
    "anchor:localnet": "solana-test-validator --reset --url https://api.devnet.solana.com --clone Memo1UhkJRfHyvLMcVucJwxXeuD728EqVDDwQDxFMNo --clone 22zoJMtdu4tQc2PzL74ZUT7FrwgB1Udec8DdW4yw4BdG"
  },
  "create-solana-dapp": {
    "instructions": [
      "Inicie o validador local com as dependências clonadas (SPL Memo e SAS):",
      "+{pm} run validator:start",
      "Verifique a saúde do validador e os programas clonados:",
      "+{pm} run validator:check",
      "Gere novos templates de teste facilmente:",
      "+{pm} run validator:template -- anchor meu_teste",
      "+{pm} run validator:template -- python meu_teste_sas",
      "Execute o build e os testes dos smart contracts:",
      "+{pm} run anchor:build",
      "+{pm} run anchor:test"
    ],
    "rename": {
      "educore_contracts": {
        "in": [
          "educore_contracts",
          "src"
        ]
      }
    }
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.24",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
