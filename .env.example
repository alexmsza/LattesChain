# ============================================================
# LattesChain — Variáveis de ambiente
# Copie para .env.local e preencha os valores reais.
# NUNCA comitar .env.local no repositório.
# ============================================================

# --- Supabase (https://supabase.com/dashboard/project/dggtjimmimrnvcrnumpz) ---
NEXT_PUBLIC_SUPABASE_URL=https://dggtjimmimrnvcrnumpz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
SUPABASE_DB_PASSWORD=<db_password>

# --- Email transacional (Lark Mail — LattesChain@jovian.foo) ---
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=LattesChain@jovian.foo
SMTP_PASS=<senha_smtp>
MAIL_FROM="LattesChain <LattesChain@jovian.foo>"

# --- Segredo de assinatura (HMAC) dos links de aprovação/rejeição por email ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=<app_secret_hex_64>

# --- URL pública da aplicação (links dos emails) ---
# Local: http://localhost:3000 | Produção: https://latteschain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Solana / SAS ---
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SAS_PROGRAM_ID=22zoJMtdu4tQc2PzL74ZUT7FrwgB1Udec8DdW4yw4BdG
